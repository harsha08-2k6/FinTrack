              "raw": "{\n  \"title\": \"Artisan Coffee & Croissant\",\n  \"description\": \"Morning routine coffee shop\",\n  \"amount\": 8.50,\n  \"categoryId\": 1,\n  \"expenseDate\": \"2026-09-01\",\n  \"paymentMethod\": \"CARD\"\n}"
