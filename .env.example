# ==============================================================================
# FinTrack - Environment Configuration Template
# NOTE: Never commit production credentials, passwords, or secrets to source control.
# Copy this file to .env or configure in your deployment platform (e.g., Render, Docker).
# ==============================================================================

# Database Configuration (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fintrack
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Eureka Service Discovery
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# ==============================================================================
# Gmail SMTP Email Notification Service Configuration
# ==============================================================================
# Host: Google's official SMTP server
SMTP_HOST=smtp.gmail.com

# Port: 587 (Standard for STARTTLS) or 465 (SSL)
SMTP_PORT=587

# Authentication Credentials
# IMPORTANT: For Gmail, you MUST use a 16-character Google App Password generated
# from https://myaccount.google.com/apppasswords. 2-Step Verification MUST be ON.
# Never use your personal Google account login password.
SMTP_USERNAME=your_corporate_sender@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# Outbound Sender Address & Display Name
SMTP_FROM_EMAIL=your_corporate_sender@gmail.com

# Feature Flag: Keep 'false' until valid credentials are provided and tested.
SMTP_ENABLED=false

# Application Frontend Base URL (used in email action links and reset URLs)
FINTRACK_APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Security: Password Recovery Token TTL
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
